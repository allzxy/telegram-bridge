@echo off
title Status Bridge-Telegram
powershell -NoProfile -ExecutionPolicy Bypass -Command "$bridgeDir = 'E:\Alfan\telegram-bridge'; $procs = Get-CimInstance Win32_Process | Where-Object { ($_.CommandLine -like '*bridge_telegram.py*' -or $_.CommandLine -like '*allzxy_bot.py*') -and $_.ProcessName -match 'python' }; Write-Host '==================================================='; Write-Host '  STATUS BRIDGE-TELEGRAM (E:\Alfan)'; Write-Host '==================================================='; Write-Host ''; if ($procs) { Write-Host '[STATUS]  : ' -NoNewline; Write-Host 'ONLINE (Aktif Berjalan di Background)' -ForegroundColor Green; foreach ($p in $procs) { Write-Host ('[PID]     : ' + $p.ProcessId + ' (' + $p.ProcessName + ')'); Write-Host ('[STARTED] : ' + $p.CreationDate) }; $sessionFile = Join-Path $bridgeDir 'active_session.json'; if (Test-Path $sessionFile) { try { $sess = Get-Content $sessionFile -Raw | ConvertFrom-Json; Write-Host ('[MODEL]   : ' + $sess.active_model); Write-Host ('[SESSION] : ' + $sess.conversation_id); Write-Host ('[TURNS]   : ' + $sess.turns + ' turns') } catch {} } } else { Write-Host '[STATUS]  : ' -NoNewline; Write-Host 'OFFLINE (Bot Tidak Berjalan)' -ForegroundColor Red; Write-Host '[INFO]    : Klik JALANKAN_BOT.bat untuk menghidupkan bot.' -ForegroundColor Yellow }; Write-Host ''; Write-Host '---------------------------------------------------'; Write-Host 'Catatan Log Aktivitas Terakhir:'; Write-Host '---------------------------------------------------'; $logFile = Join-Path $bridgeDir 'bridge_telegram.log'; if (!(Test-Path $logFile)) { $logFile = Join-Path $bridgeDir 'allzxy_bot.log' }; if (Test-Path $logFile) { Get-Content $logFile -Tail 6 -ErrorAction SilentlyContinue } else { Write-Host '(Belum ada file log)' }; Write-Host '==================================================='; Write-Host ''; Read-Host 'Tekan Enter untuk menutup...' "
